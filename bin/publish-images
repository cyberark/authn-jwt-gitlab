#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

. ./build_utils

# Publishes the 'authn-jwt-gitlab' image to docker registries
# There are 3 primary flows:
# - Publish build-specific (commit SHA) based images internally
# - Publish edge and release builds images internally and to DockerHub
# - Promote an existing image to a customer release and publish to latest
#
# If no parameters are specified, no images are pushed
function print_help() {
  echo "Usage: $0 [OPTION...] <version>"
  echo " internal: publish SHA tagged images internally"
  echo " edge: publish images as edge versions to registry.tld and dockerhub"
  echo " promote: publish images as a promotion (latest and less specific versions) to registry.tld and dockerhub"
  echo " redhat: publish image to redhat registry"
  echo " base-version=VERSION: specify base image version number to use to apply tags to"
  echo " --source-version <VERSION>: specify version number of local image"
  echo " --target-version <VERSION>: specify version number of remote image"
  echo " target: target"
}

PUBLISH_EDGE=false
PUBLISH_INTERNAL=false
PROMOTE=false
REDHAT=false
DOCKERHUB=false

LOCAL_TAG="$(version_tag)"
OS_LIST="ubuntu alpine ubi"

for arg in "$@"; do
  case $arg in
    internal )
      PUBLISH_INTERNAL=true
      shift
      ;;
    edge )
      PUBLISH_EDGE=true
      shift
      ;;
    promote )
      PROMOTE=true
      shift
      ;;
    --source-version)
      SOURCE_ARG="$2"
      shift
      ;;
    --target-version)
      TARGET_ARG="$2"
      shift
      ;;
    dockerhub )
      DOCKERHUB=true
      shift
      ;;
    --redhat )
      REDHAT=true
      shift
      ;;
    base-version=* )
      LOCAL_TAG="${arg#*=}"
      shift
      ;;
    * )
      echo "Unknown option: ${arg}"
      print_help
      exit 1
      ;;
    esac
done

echo " Check the Local Tag value :- ${LOCAL_TAG}"

if [[ "${JOB_NAME:-}" != cyberark--authn-jwt-gitlab/* ]]; then
  DOCKERHUB=false
fi

function tag_and_push() {
  local src_image=$1
  local dest_image=$2
  echo "Tagging ${src_image} as ${dest_image} and pushing..."
  docker tag "${src_image}" "${dest_image}"
  docker push "${dest_image}"
}

if [[ "$PUBLISH_INTERNAL" = true ]]; then
  echo "Publishing internal images with SHA tags..."
  echo "version: $(version)"
  for target in $OS_LIST; do
    local_image="authn-jwt-gitlab:${target}$(project_version_with_commit)"
    registry_image="registry.tld/authn-jwt-gitlab:${target}-$(version)"
    tag_and_push "${local_image}" "${registry_image}"
  done
fi

if [[ "$PUBLISH_EDGE" = true ]]; then
  echo "Publishing edge/release images for version $(version)..."
  REMOTE_TAG=edge
  readonly TAGS=(
    "$(version)"
    "$REMOTE_TAG"
  )
  for target in $OS_LIST; do
    local_image="authn-jwt-gitlab:${target}$(project_version_with_commit)"
    registry_base="registry.tld/authn-jwt-gitlab"
    for ver in "${TAGS[@]}" ; do
      tag_and_push "${local_image}" "${registry_base}:${target}-${ver}"
      if [[ "$DOCKERHUB" = true ]]; then
        tag_and_push "${local_image}" "cyberark/authn-jwt-gitlab:${target}-${ver}"
      fi
    done
  done
fi

if [[ "$PROMOTE" = true ]]; then
  if [[ -z ${SOURCE_ARG:-} || -z ${TARGET_ARG:-} ]]; then
  echo "When promoting, --source-version and --targe-version flags are required."
  print_help
  exit 1
  fi

  # Update vars to utilize utils
  SOURCE_TAG=$SOURCE_ARG
  REMOTE_TAG=$TARGET_ARG

  echo "Promoting image to $REMOTE_TAG"
  readonly TAGS=(
    "$REMOTE_TAG"
    "latest"
  )
  registry_base="registry.tld/authn-jwt-gitlab"
  for target in $OS_LIST; do
    local_image="authn-jwt-gitlab:${target}$(project_version_with_commit)"
    for ver in "${TAGS[@]}" $(gen_versions "$REMOTE_TAG"); do
      tag_and_push "${local_image}" "${registry_base}:${target}-${ver}"
      if [[ "$DOCKERHUB" = true ]]; then
        tag_and_push "${local_image}" "cyberark/authn-jwt-gitlab:${target}${ver}"
      fi
    done
  done
fi

#  ========== To Do =============
